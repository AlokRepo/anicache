  "title": {
    "romaji": "Futsutsuka na Akujo de wa Gozaimasu ga: Suuguu Chouso Torikae Den",
    "english": "Though I Am an Inept Villainess",
    "native": "ふつつかな悪女ではございますが ~雛宮蝶鼠とりかえ伝~"
  },
