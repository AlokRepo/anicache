  "title": {
    "romaji": "Zatsuyou Fuyojutsu-shi ga Jibun no Saikyou ni Kizuku Made",
    "english": "Zatsuyou Fuyojutsu-shi ga Jibun no Saikyou ni Kizuku Made",
    "native": "雑用付与術師が自分の最強に気付くまで"
  },
  "synonyms": [
    "Magical Buffs: The Support Caster is Stronger Than He Realized!",
    "ZatsuyoFuyo"
  ],
  "coverImage": {
