    "romaji": "Chuunibyou demo Koi ga Shitai!",
    "english": "Love, Chunibyo & Other Delusions",
    "native": "中二病でも恋がしたい!"
  },
  "synonyms": [
    "Chu-2 Byo demo Koi ga Shitai!",
    "Regardless of My Adolescent Delusions of Grandeur, I Want a Date!",
    "Miłość, gimbaza i kosmiczna faza",
    "中二病也要谈恋爱！"
  ],
  "coverImage": {
    "extraLarge": "https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx14741-CGXEIeUe2roA.jpg",
